# Async driver URL used by both the app and Alembic.
DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger

# How many times a posting will re-read versions and retry after losing an optimistic CAS.
MAX_POSTING_RETRIES=25

# Write a balance snapshot every N entries, per account. 0 disables snapshots.
SNAPSHOT_EVERY=100
